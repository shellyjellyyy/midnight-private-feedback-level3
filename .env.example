[TEMPLATE]
# Copy this file to .env and fill in real values locally.
# .env is gitignored — never commit real values.

# Network the frontend and deployment scripts should target.
# The LIVE, verified deployment is on Preview. Use "preview" unless you are
# deliberately building the (currently chain-blocked) v9/Preprod path.
VITE_MIDNIGHT_NETWORK_ID=preview

# Deployed contract address.
#
# LIVE Preview deployment (retained ledger-v8 era), verified 2026-09-30:
VITE_CONTRACT_ADDRESS=916ae63acf5d4256a33c249cf138938cb9cb33210cf6081feecb2a18648248bc
#
# For the v9/Preprod path, leave this BLANK until you really deploy there —
# never invent an address. That path is blocked by the chain until the
# ledger-v9 fork is enacted (see README §6).

# Base URL where compiled ZK artifacts (prover/verifier keys) are hosted for
# the browser to fetch during proof generation, if not served from /public.
VITE_ZK_ARTIFACTS_URL=

# Only needed for local/CLI deployment scripts run outside the browser
# wallet flow (e.g. an admin registration script). Generate locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real value for this.
MIDNIGHT_PREPROD_SEED=

# ---------------------------------------------------------------------------
# Required runtime patch (Preview / retained v8 path)
# ---------------------------------------------------------------------------
# The Preview wallet path needs one patch to @midnight-ntwrk/wallet-sdk-dust-wallet
# and @midnightntwrk/wallet-sdk-dust-wallet. Without it every contract call is
# rejected by the Preview mempool with "Custom error: 117" (NotNormalized).
# `npm ci` wipes node_modules, so re-run this after EVERY install:
#     npm run patch:dust
# Verify it is applied, idempotent, reversible and era-safe:
#     npm run check:dust-patch
# See README §17 for the full explanation.

# ---------------------------------------------------------------------------
# Deployment era (dual-build)
# ---------------------------------------------------------------------------
# Frontend build-time era switch. Leave unset for the default v9 build
# (managed/feedback, compactc 0.34.0 / runtime 0.19.0, Preprod). Set to
# "v8-preview" for the Preview-era bundle (managed/feedback-v8, compactc
# 0.31.1 / runtime 0.16.0, live Preview network) — which is what
# `npm run build:preview` does.
VITE_MIDNIGHT_ERA=

# Admin wallet seed for the Preview-era CLI deploy/E2E script
# (scripts/deploy-preview.mjs). Takes precedence over the gitignored
# .admin-seed-preview file. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real value for this.
MIDNIGHT_PREVIEW_SEED=

# Optional: explicit participant seed for the Preview E2E script. When unset,
# the script generates a fresh random seed and persists it to the gitignored
# .participant-seed-preview file for phase continuity.
MIDNIGHT_PARTICIPANT_SEED_PREVIEW=
